# UniFi Site Manager API key
# Get one at https://unifi.ui.com -> API -> Create API Key
UNIFI_API_KEY=your-api-key-here

# Optional: Override Site Manager API base URL
UNIFI_API_BASE=https://api.ui.com

# Express proxy port (web dev server proxies /api -> here)
PORT=4000

# Cache TTL in seconds for proxied UniFi responses
CACHE_TTL_SECONDS=20

# Optional shared secret. If set, requests to the proxy must include
# header "x-dashboard-token: <value>". Leave empty for local LAN-only use.
DASHBOARD_TOKEN=
